{
  "name": "greenherb-sprint4-swagger",
  "version": "1.0.0",
  "description": "GREENHERB API - Sprint 4 com Swagger/OpenAPI e testes de integração em Jest/Supertest",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "swagger:json": "node -e \"const fs=require('fs'); fs.writeFileSync('swagger.json', JSON.stringify(require('./src/config/swagger'), null, 2));\"",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration/swagger.integration.test.js --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
